<https://ostrails.github.io/assessment-component-metadata-records/benchmark/FB-DABAR.ttl> a ftr:Benchmark, dcat:Resource ;
    dcterms:identifier "https://ostrails.github.io/assessment-component-metadata-records/benchmark/FB-DABAR.ttl"^^xsd:string ;
    rdfs:isDefinedBy "https://ostrails.github.io/assessment-component-metadata-records/benchmark/FB-DABAR.ttl"^^xsd:anyURI ;
    dcat:landingPage "https://ostrails.github.io/assessment-component-metadata-records/benchmark/FB-DABAR.ttl"^^xsd:anyURI ;
    dcterms:title "FAIR Benchmark - DABAR FAIR Assessment"^^xsd:string ;
    rdfs:label "FB-DABAR"^^xsd:string ;
    vivo:abbreviation "FB-DABAR"^^xsd:string ;
    dcterms:description """The DABAR FAIR Assessment Benchmark provides a structured framework for evaluating the FAIRness of dataset metadata deposited in DABAR institutional repositories. It translates the FAIR Principles into transparent, community-specific criteria covering findability, accessibility, interoperability and reusability. The benchmark distinguishes features implemented automatically by the repository from those that depend on information provided by researchers, making responsibilities and opportunities for improvement clearer. It supports consistent, reusable and comparable FAIR assessments across repositories and assessment tools."""^^xsd:string ;
    
    schema:about "Not applicable"^^xsd:string, "Not applicable"^^xsd:string ;
    ftr:applicationArea <http://www.fairsharing.org/ontology/subject/SRAO_0000401>, <http://www.fairsharing.org/ontology/subject/SRAO_0000401> ;
    
    dcat:version "1.0.0"^^xsd:string ;
    
    
    ftr:status "Active"@en ;
     
    
    
    
    
    
    ftr:supportedBy <https://w3id.org/FAIR-Champion> ;
    dpv:IsApplicableFor <https://schema.org/Dataset>;
    dcterms:creator <https://fairsharing.org/organisations/5933>; 
    
    
    
    
    
    
    dcterms:publisher  <https://orcid.org/0000-0003-1138-4188>  ; 
    dcat:contactPoint  <https://orcid.org/0000-0003-1138-4188>  . 




<https://fairsharing.org/organisations/5933> a vcard:Organisation ;
    vcard:organisation-name "IRB"^^xsd:string .

<https://orcid.org/0000-0003-1138-4188> a vcard:Individual, foaf:Agent ;
    vcard:fn "Bojan Macan"^^xsd:string ;
    vcard:hasEmail <mailto:bmacan@irb.hr> .
    

