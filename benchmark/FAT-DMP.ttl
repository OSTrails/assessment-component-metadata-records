<https://ostrails.github.io/assessment-component-metadata-records/benchmark/FAT-DMP.ttl> a ftr:Benchmark, dcat:Resource ;
    dcterms:identifier "https://ostrails.github.io/assessment-component-metadata-records/benchmark/FAT-DMP.ttl"^^xsd:string ;
    rdfs:isDefinedBy "https://ostrails.github.io/assessment-component-metadata-records/benchmark/FAT-DMP.ttl"^^xsd:anyURI ;
    dcat:landingPage "https://ostrails.github.io/assessment-component-metadata-records/benchmark/FAT-DMP.ttl"^^xsd:anyURI ;
    dcterms:title "FAIR Assessment Tool for DMPs (TU-NET) "^^xsd:string ;
    rdfs:label "FAT-DMP"^^xsd:string ;
    vivo:abbreviation "FAT-DMP"^^xsd:string ;
    dcterms:description """
|                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      |
| -------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |
| The FAT-DMP (TU-NET) benchmark determine the FAIRness of DMPs produced by researchers within the Technology University Network (TU-NET) in Ireland; some test use FAIRsharing metadata while others examine the DMP metadata directly. TU-NET is a network for the Irish Technological Universities to share expertise, information and resources where possible across the research landscape, with an emphasis on Open Research.<br>This benchmark is of primary utility for researchers and data managers within the TU-NET community, including those in RDM support roles who may utilise scores derived from the benchmark to assess compliance with institutional Open Research policies and/or opportunities for researcher CPD/RDM skills development.<br>This benchmark enables the FAIR assessment of DMPs for research projects published via Zenodo, using metadata associated with the DMP itself (as distinct from the datasets described therein), with the aim of promoting a minimum standard of FAIRness in line with TU-NET's dedication to the values of openness, transparency, and research integrity. While provisions for DMPs containing proprietary information will be required, with embargos placed on DMPs when necessary, the FAIR benchmark will be applicable to all DMPs.<br> The FAIR assessment of DMPs will promote and encourage the publication of DMPs as outputs, in and of themselves, as well as promote a continual culture of Open Research across the data lifecycle. |


"""^^xsd:string ;
    dcat:keyword "FAIR"^^xsd:string, "Data Management Plan (DMP)"^^xsd:string ;
    schema:about "All"^^xsd:string ;
    ftr:applicationArea <http://www.fairsharing.org/ontology/subject/SRAO_0000401> ;
    
    dcat:version "0.2.0"^^xsd:string ;
    
    
    
    
    dcterms:license <https://creativecommons.org/licenses/by/4.0/>, <http://creativecommons.org/licenses/by/4.0/> ;
    ftr:status "Active"@en ;
     
    
    
    
    
    
    ftr:supportedBy <https://w3id.org/FAIR-Champion> ;
    dpv:IsApplicableFor <https://vocabularies.coar-repositories.org/resource_types/c_ab20/>;

    
    
    
    
    dcterms:creator <https://ror.org/04t0qbt32> ;


    
    
    
    
    
    
    dcterms:publisher  <https://orcid.org/0009-0005-7386-0401> ,  <https://orcid.org/0000-0002-7642-5326>  ; 
    dcat:contactPoint  <https://orcid.org/0009-0005-7386-0401> ,  <https://orcid.org/0000-0002-7642-5326>  . 




