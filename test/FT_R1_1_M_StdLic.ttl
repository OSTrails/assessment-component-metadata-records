    rdfs:label "FT_R1_1_M_StdLic"^^xsd:string ;
    vivo:abbreviation "FT_R1_1_M_StdLic"^^xsd:string ;
    dcterms:description """This test evaluates whether there is an explicit licence declaration present in the metadata retrieved upon resolution of the provided identifier. If the record contains a licence and it is a valid URL it will pass; otherwise, the test will fail."""^^xsd:string ;
    
    
