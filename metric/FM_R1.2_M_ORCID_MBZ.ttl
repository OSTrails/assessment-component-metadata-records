<https://ostrails.github.io/assessment-component-metadata-records/metric/FM_R1.2_M_ORCID_MBZ.ttl> a ftr:Metric, dqv:Metric, dcat:Resource ;
    dcterms:identifier "https://ostrails.github.io/assessment-component-metadata-records/metric/FM_R1.2_M_ORCID_MBZ.ttl"^^xsd:string ;
    rdfs:isDefinedBy "https://ostrails.github.io/assessment-component-metadata-records/metric/FM_R1.2_M_ORCID_MBZ.ttl"^^xsd:anyURI ;
    dcat:landingPage "https://ostrails.github.io/assessment-component-metadata-records/metric/FM_R1.2_M_ORCID_MBZ.ttl"^^xsd:anyURI ;
    dcterms:title "FAIR Metric – R1.2 – Metadata – ORCID or MBZ identifiers for people"^^xsd:string ;
    rdfs:label "FM_R1.2_M_ORCID_MBZ"^^xsd:string ;
    vivo:abbreviation "FM_R1.2_M_ORCID_MBZ"^^xsd:string ;
    dcterms:description """Individuals associated with a DABAR record may be identified using ORCIDs or Croatian researcher identification number (MBZ). Evaluation under this metric assesses whether at least one qualified reference to ORCID or MBZ is present for a contributor with the ‘author’ role. The presence of ORCIDs or MBZs linked to individuals, together with the defined ‘author’ role, constitutes a qualified provenance reference.

Where this information is present, at least one declaration is sufficient to pass this metric."""^^xsd:string ;
    
    schema:about "Not applicable"^^xsd:string, "Not applicable"^^xsd:string ;
    ftr:applicationArea <http://www.fairsharing.org/ontology/subject/SRAO_0000401>, <http://www.fairsharing.org/ontology/subject/SRAO_0000401> ;
    ftr:inDimension <https://w3id.org/fair/principles/terms/R1.2>, <https://w3id.org/fair/principles/terms/R> ;
    dcat:version "1.0.0"^^xsd:string ;
    
    
    ftr:status "Active"@en ;
     
    
    
    
    
    
    ftr:supportedBy <https://w3id.org/FAIR-Champion> ;
    dpv:IsApplicableFor <https://schema.org/Dataset>;
