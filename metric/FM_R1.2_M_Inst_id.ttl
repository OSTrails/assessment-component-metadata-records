<https://ostrails.github.io/assessment-component-metadata-records/metric/FM_R1.2_M_Inst_id.ttl> a ftr:Metric, dqv:Metric, dcat:Resource ;
    dcterms:identifier "https://ostrails.github.io/assessment-component-metadata-records/metric/FM_R1.2_M_Inst_id.ttl"^^xsd:string ;
    rdfs:isDefinedBy "https://ostrails.github.io/assessment-component-metadata-records/metric/FM_R1.2_M_Inst_id.ttl"^^xsd:anyURI ;
    dcat:landingPage "https://ostrails.github.io/assessment-component-metadata-records/metric/FM_R1.2_M_Inst_id.ttl"^^xsd:anyURI ;
    dcterms:title "FAIR Metric – R1.2 – Metadata – Institutional identification"^^xsd:string ;
    rdfs:label "FM_R1.2_M_Inst_id"^^xsd:string ;
    vivo:abbreviation "FM_R1.2_M_Inst_id"^^xsd:string ;
    dcterms:description """This metric evaluates whether the metadata record explicitly associates each named creator with their organisational affiliation. The evaluation checks for structured metadata properties that link individual authors to their affiliated organisations and verifies whether the affiliation is provided either as a literal string or, preferably, as a persistent identifier for the organisation (e.g., a Croatian organisation identifier (OIB) or CroRIS ID). The metric specifically assesses whether the affiliation is linked directly to the individual author entities within the record’s provenance chain. Role assignments establish qualified relationships between individuals and their affiliated organisations. Non-Croatian organisations associated with contributors are not expected to be identified using CroRIS identifiers."""^^xsd:string ;
    
    schema:about "Not applicable"^^xsd:string, "Not applicable"^^xsd:string ;
    ftr:applicationArea <http://www.fairsharing.org/ontology/subject/SRAO_0000401>, <http://www.fairsharing.org/ontology/subject/SRAO_0000401> ;
    ftr:inDimension <https://w3id.org/fair/principles/terms/R1.2>, <https://w3id.org/fair/principles/terms/R> ;
    dcat:version "1.0.0"^^xsd:string ;
    
    
    ftr:status "Active"@en ;
     
    
    
    
    
    
    ftr:supportedBy <https://w3id.org/FAIR-Champion> ;
    dpv:IsApplicableFor <https://schema.org/Dataset>;
    dcterms:creator <https://fairsharing.org/organisations/>; 
    
    
    
    
    
    
    dcterms:publisher  <https://orcid.org/0000-0003-1138-4188>  ; 
    dcat:contactPoint  <https://orcid.org/0000-0003-1138-4188>  . 




